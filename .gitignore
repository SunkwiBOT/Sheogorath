# Data files
*.json
!package.json
!package-lock.json
!tsconfig.json
# Per-guild wiring (guild/channel/role IDs, not secrets). Must be deployable.
!config/guilds.json
# Runtime state — state.json, memories.json, saved playlists. Not deployable,
# and rewritten by the bot as it runs.
data/*
# ...except the knowledge notes, which are written by hand and have to ship with
# the bot. Spelled as `data/*` plus a negation because git never descends into a
# directory excluded outright, so `data/` would make this re-include unreachable.
!data/knowledge/
src/data/
*.data
*.dat

# Cache files
cache.json
data/cache.json
*.cache

# Discord bot specific
discord-bot/cache/
discord-bot/*.log

# Backup files
*.bak
*.backup
*~instagram-cookies.txt
www.instagram.com_cookies.txt
x.com_cookies.txt
www.reddit.com_cookies.txt
data/tts-usage.json
logs/

# The control API web page lives in a directory named "public" but is source,
# not build output. The Gatsby rule above would otherwise silently exclude it.
!src/api/public/
!src/api/public/**

# Deployment artifacts and secrets that live only on the Leviathan box.
# .env.save and instagram-cookies.txt hold credentials; they were untracked but
# NOT ignored, so a `git add -A` run on the server would have committed them.
.env.save
instagram-cookies.txt
sheogorath.lock
*.bak
*.bak.*
